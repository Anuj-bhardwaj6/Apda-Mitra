# ==============================================================================
# APDA MITRA - Environment Configuration Template
# Copy to .env and configure secret keys prior to deployment
# ==============================================================================

# Application
PROJECT_NAME="APDA MITRA - AI Disaster Intelligence Platform"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="production"
DEBUG=false
LOG_LEVEL="INFO"

# Server Host & Port
HOST="0.0.0.0"
PORT=8000
ALLOWED_HOSTS=["*"]
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database (PostgreSQL 16 + PostGIS)
POSTGRES_USER="apda_admin"
POSTGRES_PASSWORD="ChangeMeInProduction_StrongPassword123!"
POSTGRES_DB="apda_mitra_db"
POSTGRES_HOST="postgres"
POSTGRES_PORT=5432
DATABASE_URL="postgresql+asyncpg://apda_admin:ChangeMeInProduction_StrongPassword123!@postgres:5432/apda_mitra_db"
SYNC_DATABASE_URL="postgresql://apda_admin:ChangeMeInProduction_StrongPassword123!@postgres:5432/apda_mitra_db"

# Redis Cache & Session Store
REDIS_HOST="redis"
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=""
REDIS_URL="redis://redis:6379/0"

# Security & JWT Tokens (Generate via: openssl rand -hex 32)
SECRET_KEY="replace_with_64_character_hex_random_key_for_session_encryption"
JWT_SECRET="replace_with_64_character_hex_random_key_for_jwt_signature"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# External Disaster Intelligence APIs
OPEN_METEO_API_KEY=""
NASA_API_KEY=""
ISRO_API_KEY=""
IMD_API_KEY=""
FIREBASE_KEY=""
GOOGLE_MAPS_KEY=""
SMS_PROVIDER_KEY=""
EMAIL_PROVIDER_KEY=""
